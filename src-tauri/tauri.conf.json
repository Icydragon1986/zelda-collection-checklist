{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zelda Collection Checklist",
  "mainBinaryName": "Zelda Collection Checklist",
  "version": "0.7.0",
  "identifier": "com.zelda.checklist",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Zelda Collection Checklist",
        "width": 1080,
        "height": 800,
        "minWidth": 760,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/covers/**", "$RESOURCE/images/**/*"]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "resources": {
      "resources/images/": "images"
    },
    "windows": {
      "nsis": {
        "compression": "zlib"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZGREZBRkVDMkY3OTE0QzQKUldURUZIa3Y3Sy9mYjNRNDBzMUZLakpBM2NJbXZvSFRUM21wUGpNaUJLT2hsdDhwa1MyTk4rblQK",
      "endpoints": [
        "https://github.com/icydragon1986/zelda-collection-checklist/releases/latest/download/latest.json"
      ]
    }
  }
}
